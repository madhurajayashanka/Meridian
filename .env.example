# Meridian Platform — Environment Configuration

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=meridian
DATABASE_URL=postgresql+asyncpg://meridian:change_me_in_production@localhost:5432/meridian

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379

# ============================================================================
# JWT & Security
# ============================================================================
# Generate RSA keypair:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_SECRET_KEY=your_private_key_here
JWT_PUBLIC_KEY=your_public_key_here
WEBHOOK_SECRET=generate_a_random_32char_secret_here
INTERNAL_API_KEY=generate_a_random_32char_internal_key_here
JWT_ISSUER_URI=http://localhost:8000
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ============================================================================
# CORS (comma-separated list of allowed origins)
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# API Service Configuration (Spring Boot)
# ============================================================================
API_PORT=8000
API_ENV=development
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/meridian
SPRING_DATASOURCE_USERNAME=meridian
SPRING_DATASOURCE_PASSWORD=meridian_dev_password
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# Rate limiting
RATE_LIMIT_GENERAL_REQ_PER_MIN=60
RATE_LIMIT_JOB_REQ_PER_HOUR=5

# Content policy placeholder
CONTENT_POLICY_ENABLED=true

# ============================================================================
# AI Service Configuration (FastAPI)
# ============================================================================
AI_SERVICE_PORT=8080
AI_ENV=development
AI_SERVICE_URL=http://localhost:8080
LOG_LEVEL=INFO

# LLM Provider: "bedrock", "openai", or "mock" for development
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AWS Bedrock Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# Use an inference profile ID/ARN for models that do not support on-demand throughput.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID_FAST=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ============================================================================
# Third-Party Services
# ============================================================================
# Tavily API for web search
TAVILY_API_KEY=your_tavily_key_here

# ============================================================================
# AWS S3 / MinIO Configuration
# ============================================================================
S3_BUCKET=meridian-documents-local
S3_REGION=us-east-1
# For local dev, MinIO runs in Docker — leave S3_ENDPOINT_URL blank for real AWS
S3_ENDPOINT_URL=http://localhost:9000

# MinIO credentials (local dev only — matches docker-compose.yml)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ============================================================================
# Frontend Configuration (Next.js)
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_URL=http://localhost:8080
NEXT_PUBLIC_ENV=development

# ============================================================================
# Application Settings
# ============================================================================
# Report content local storage (used when S3 is not configured)
REPORT_CONTENT_DIR=/tmp/meridian-reports
# Research depth configuration
RESEARCH_QUICK_AGENTS=planner,research
RESEARCH_STANDARD_AGENTS=planner,research,analysis,critic,synthesizer
RESEARCH_DEEP_AGENTS=planner,research,analysis,critic,synthesizer
RESEARCH_DEEP_MAX_CRITIC_ITERATIONS=3

# Document upload limits
MAX_UPLOAD_SIZE_MB=10
MAX_DOCUMENTS_PER_JOB=5
ALLOWED_DOCUMENT_TYPES=pdf,txt

# ============================================================================
# Testing & Development
# ============================================================================
E2E_WITH_LLM=false  # Set to true to use real LLM in E2E tests
MOCK_TAVILY_RESPONSES=true
DEBUG=false

# ============================================================================
# Observability
# ============================================================================
PROMETHEUS_ENABLED=true
JAEGER_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces
