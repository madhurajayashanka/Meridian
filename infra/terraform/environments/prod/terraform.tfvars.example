# Copy to terraform.tfvars and fill in values.
# Secrets (rds_password, eks_public_access_cidrs, app_domain) must be set
# via TF_VAR_* environment variables — never commit them here.
#
# export TF_VAR_rds_password="$(aws secretsmanager get-secret-value --secret-id meridian/rds/password --query SecretString --output text)"
# export TF_VAR_eks_public_access_cidrs='["1.2.3.4/32"]'
# export TF_VAR_app_domain="yourdomain.com"

environment           = "production"
aws_region            = "us-east-1"
rds_instance_class    = "db.t4g.medium"
rds_allocated_storage = 100
rds_engine_version    = "16"
rds_ca_identifier     = "rds-ca-rsa2048-g1"
redis_node_type       = "cache.t4g.small"
redis_num_cache_nodes = 2
eks_desired_size      = 3
eks_min_size          = 2
eks_max_size          = 10
eks_cluster_version   = "1.30"
eks_instance_type     = "t3.medium"
enable_nat_gateway    = true
rds_db_name           = "meridiandb"
rds_username          = "meridian"
